# Environment Variables Example for AURA Luxe Mobile
# Copy this file to .env.local for local overrides

# Supabase (Optional: for cloud persistence)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI Assistant Concierge & Admin Autofill
# Primary: Groq API (Recommended: Llama 3.3 70B & 3.1 8B - Ultra-fast & High Free Credit Limits)
# Get a free API key at: https://console.groq.com/keys
GROQ_API_KEY=

# Fallback: Google Gemini API (Optional)
# Get key at: https://aistudio.google.com
GEMINI_API_KEY=
